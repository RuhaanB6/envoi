{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./backend/.env*)",
      "Bash(git push --force*)",
      "Bash(rm -rf *)",
      "Bash(docker compose down -v*)"
    ],
    "allow": [
      "Bash(uv *)",
      "Bash(backend/.venv/bin/*)",
      "Bash(python -m pytest*)",
      "Bash(ruff *)",
      "Bash(uvicorn *)",
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx oxlint *)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(psql *)",
      "Bash(yoyo *)",
      "Bash(gh pr *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-migrations.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh"
          }
        ]
      }
    ]
  }
}
